---
layout: base.njk
---
{%- set alt = imageAlt or title %}
<section class="hero grad"><div class="wrap"><div class="crumb"><a href="/index.html">Home</a> › <a href="/portfolio.html">Portfolio</a> › {{ title }}</div><div class="eyebrow">Our Work</div><h1>{{ title }}</h1>{% if location %}<p>{{ location }}</p>{% endif %}</div></section>
<section><div class="wrap" style="max-width:1000px">
{%- if beforePhoto %}
<div class="ba"><img src="{{ photo }}" alt="After: {{ alt }}"><img class="ba-before" src="{{ beforePhoto }}" alt="Before: {{ alt }}"><div class="ba-div"><span class="ba-grip">&#9664;&#9654;</span></div><input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after"><span class="ba-tag ba-tag-l">Before</span><span class="ba-tag ba-tag-r">After</span></div>
{%- else %}
<a href="{{ photo }}"><img src="{{ photo }}" alt="{{ alt }}" style="width:100%;max-height:620px;object-fit:cover;border-radius:12px;box-shadow:0 18px 40px rgba(13,27,46,.16)"></a>
{%- endif %}
{%- if details %}<p style="font-size:18px;line-height:1.7;color:#26303f;margin:30px 0 0">{{ details }}</p>{% endif %}
{%- if gallery and gallery.length %}
<h2 style="font-family:'Lora',serif;font-size:30px;color:#0d1b2e;margin:44px 0 18px">Project Photos</h2>
<div class="grid g3">
{%- for g in gallery %}
<a href="{{ g.image }}" class="card" style="text-decoration:none"><img src="{{ g.image }}" alt="{{ g.caption or alt }}" loading="lazy">{% if g.caption %}<div class="body" style="padding:12px 16px"><p style="margin:0;font-size:14px;color:#3a4456">{{ g.caption }}</p></div>{% endif %}</a>
{%- endfor %}
</div>
{%- endif %}
<p style="margin-top:40px;display:flex;gap:24px;flex-wrap:wrap"><a href="/portfolio.html" style="color:#c1212f;font-weight:700">← Back to all projects</a><a href="/contact.html" style="color:#c1212f;font-weight:700">Get a free estimate for your project →</a></p>
</div></section>
